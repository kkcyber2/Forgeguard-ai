# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Vercel AI SDK Configuration
# Optional: For analytics (https://vercel.com/docs/ai-sdk/ai-sdk-core/telemetry)
AI_SDK_LOG_LEVEL=info

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ForgeGuard AI

# Payments — Lemon Squeezy (optional until live checkout is configured)
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_VARIANT_STARTUP=
# LEMONSQUEEZY_VARIANT_ENTERPRISE=
# LEMONSQUEEZY_VARIANT_BAZAAR=
# REVENUE_SIMULATION_MODE=true  # Bazaar + billing: grant access instantly without LS redirect

# Optional: Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Railway bunker / Hugging Face — Python Agathon engine (valosd453-bit/AI-red-team)
# Set in Vercel Production; must match INTERNAL_SCAN_TOKEN on the engine service
PYTHON_ENGINE_URL=https://your-bunker.up.railway.app
INTERNAL_SCAN_TOKEN=shared-secret-with-railway
# Legacy alias (optional)
# AGATHON_ORCHESTRATOR_URL=https://your-bunker.up.railway.app
# Webhook ingress (Genesis 3.0)
# AGATHON_WEBHOOK_SECRET=shared-secret-for-supabase-db-webhooks
# Sovereign gate fallbacks (canonical: ksk805763@gmail.com always allowed)
ADMIN_EMAIL=ksk805763@gmail.com
SOVEREIGN_OPERATOR_EMAIL=ksk805763@gmail.com
# Legacy fallback (optional if INTERNAL_SCAN_TOKEN is set)
# AGATHON_INTERNAL_SECRET=shared-secret-with-railway

# Scan credential encryption (AES key for target API keys)
SCAN_CREDENTIAL_SECRET=your-32-byte-secret-here

# OpenRouter (Railway engine only — DeepSeek-V3 attack mutations)
# OPENROUTER_API_KEY=sk-or-v1-...
