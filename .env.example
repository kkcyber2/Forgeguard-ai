# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=https://www.forgeguard-ai.com
NEXT_PUBLIC_APP_NAME=ForgeGuard AI
ALLOWED_ORIGINS=https://www.forgeguard-ai.com

# Sovereign operator / admin gate
SOVEREIGN_OPERATOR_EMAIL=your-operator@email.com
ADMIN_EMAIL=your-operator@email.com

# Railway Agathon engine (must match INTERNAL_SCAN_TOKEN on Railway)
PYTHON_ENGINE_URL=https://your-engine.up.railway.app
INTERNAL_SCAN_TOKEN=shared-secret-with-railway
WAR_MACHINE_URL=https://your-war-machine.up.railway.app

# Sovereign Vault — NOWPayments crypto (USDT / SOL / BTC)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-ipn-hmac-secret
SOVEREIGN_CRYPTO_WALLET=optional-fallback-usdt-address

# Credit packs (Bazaar wallet — not subscription)
CREDIT_PACK_USD=10
CREDIT_PACK_AMOUNT=100
SCAN_OVERAGE_WALLET_DEBIT_USD=1

# AI providers
OPENROUTER_API_KEY=sk-or-v1-...
GROQ_API_KEY=your-groq-api-key-here

# Scan target credential encryption
SCAN_CREDENTIAL_SECRET=your-32-byte-secret-here

# Dev / simulation
# REVENUE_SIMULATION_MODE=true
# TWILIO_SIMULATION_MODE=true

# Twilio — Stronghold phone OTP (production)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Rate limiting (in-memory fallback; Upstash optional P2)
RATE_LIMIT_REQUESTS_PER_MINUTE=10
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Deprecated — do not use for new billing
# LEMONSQUEEZY_API_KEY=
# NEXT_PUBLIC_STRIPE_CHECKOUT_STARTUP=
# AGATHON_ORCHESTRATOR_URL=  # use PYTHON_ENGINE_URL
# AGATHON_INTERNAL_SECRET=   # use INTERNAL_SCAN_TOKEN
